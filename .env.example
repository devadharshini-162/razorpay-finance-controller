# Deterministic reconciliation works without an API key.
# Set GEMINI_ENABLED=true only when a Gemini API key is available.
GEMINI_ENABLED=false
GEMINI_API_KEY=
# Flash Lite is a practical default for quota-conscious batch arbitration.
GEMINI_MODEL=gemini-2.5-flash-lite
# auto calls Gemini only for unfamiliar CSV schemas; true always enriches;
# false uses deterministic header mapping only.
GEMINI_SCHEMA_MAPPING_ENABLED=auto
# Bound each provider request so failures degrade gracefully.
GEMINI_TIMEOUT_SECONDS=5
